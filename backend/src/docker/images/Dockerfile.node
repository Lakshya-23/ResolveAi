FROM node:20-bookworm-slim

# Install system tools used by agents
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    ripgrep \
    fd-find \
    jq \
    && rm -rf /var/lib/apt/lists/*

# fd is installed as fdfind on Debian — create symlink
RUN ln -sf /usr/bin/fdfind /usr/bin/fd

# Set working directory
WORKDIR /workspace

# Default command: keep container alive
CMD ["tail", "-f", "/dev/null"]
