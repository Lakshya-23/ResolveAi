# ─── ResolvAI Backend Configuration ───

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# LiteLLM Proxy URL
LITELLM_BASE_URL=http://localhost:4000

# GitHub API
GITHUB_API_URL=https://api.github.com

# SQLite Database Location
DB_PATH=./data/resolveai.db

# Docker Engine Socket & Workspace Base Directory
# DOCKER_SOCKET_PATH is auto-detected (/run/user/1000/docker.sock, podman.sock, or /var/run/docker.sock).
# Leave commented unless you have a custom non-standard Docker socket.
# DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_WORKSPACE_BASE=/tmp/resolveai-workspaces

# ─── LLM Provider API Keys (Backend is Single Source of Truth) ───
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...

# ─── Optional Tavily Web Search API Key ───
TAVILY_API_KEY=tvly-...

# ─── Git Author Identity ───
GIT_AUTHOR_NAME=ResolvAI
GIT_AUTHOR_EMAIL=bot@resolvai.dev

# ─── Supervisor Agent Settings ───
SUPERVISOR_MAX_ITERATIONS=25

# ─── Default Agent Model & Provider Overrides (Optional) ───
# SUPERVISOR_MODEL=openai/gpt-4o
# SUPERVISOR_PROVIDER=openai
# PLANNER_MODEL=openai/gpt-4o
# PLANNER_PROVIDER=openai
# WRITER_MODEL=openai/gpt-4o
# WRITER_PROVIDER=openai
# TESTER_MODEL=openai/gpt-4o
# TESTER_PROVIDER=openai
# REVIEWER_MODEL=openai/gpt-4o
# REVIEWER_PROVIDER=openai

# Logging
LOG_LEVEL=info
